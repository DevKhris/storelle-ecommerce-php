<?php foreach ($reviews as $review) { ?>
<div class="reviews card my-4 shadow">
    <div class="card-header">
        <h4 class="my-3 mx-auto">
            <?= $review->getAuthor()?->getUsername() ?? 'Unknown' ?>
        </h4>
        <h5>
            <div id=stars>
                <?php for ($i = 0; $i < $review->getRating(); $i++) { ?>
                <i class="fa fa-star stars"></i>
                <?php } ?>
                <?php 
                    $limit =  max(0, 5 - ceil($review->getRating()));
                    for ($i = 0; $i < $limit; $i++) { 
                ?>
                <i class="fa fa-star stars-grey"></i>
                <?php } ?>
            </div>
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            <?= $review->getContent(); ?>
        </p>
    </div>
</div>
<?php } ?>