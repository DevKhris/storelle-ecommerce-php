            <div class="card-deck">
                <a class="text-decoration-none product-link font-weight-bold" href="product">
                    <div class="card shadow-sm shadow-lg product text-center my-2">
                        <img src="{{ $this->escape($product->getImageUrl()) }}"
                            class="card-img-top align-self-center img-fluid" width=360 height=240
                            alt="{{ $product->getName() }}">
                        <div class="card-body">
                            <h3 class="card-title">{{ $this->escape($product->getName()) }}</h3>
                            <span class="card-text">{{ $this->escape($product->getprice()) }}</span>
                        </div>
                        <div class="card-footer">
